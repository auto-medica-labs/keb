{
  "name": "chrome-kb",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@10.24.0",
  "scripts": {
    "dev": "pnpm --filter @chrome-kb/extension dev",
    "build": "pnpm --filter @chrome-kb/extension --filter @chrome-kb/landing build",
    "typecheck": "pnpm --filter './packages/*' typecheck",
    "preview": "pnpm --filter @chrome-kb/extension preview",
    "bridge": "pnpm --filter @chrome-kb/bridge start",
    "bridge:dev": "pnpm --filter @chrome-kb/bridge dev",
    "lint": "oxlint",
    "format": "oxfmt --write packages",
    "format:check": "oxfmt --check packages"
  },
  "devDependencies": {
    "oxfmt": "^0.51.0",
    "oxlint": "^1.66.0"
  }
}

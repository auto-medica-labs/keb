{
  "name": "chrome-kb",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@10.24.0",
  "scripts": {
    "dev": "pnpm --filter @chrome-kb/extension dev",
    "build": "pnpm --filter @chrome-kb/extension build",
    "typecheck": "pnpm --filter @chrome-kb/extension typecheck",
    "preview": "pnpm --filter @chrome-kb/extension preview",
    "bridge": "pnpm --filter @chrome-kb/bridge start",
    "bridge:dev": "pnpm --filter @chrome-kb/bridge dev"
  }
}

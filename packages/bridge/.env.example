# =============================================================================
# chrome-kb bridge — environment variables
#
# Copy this file and fill in your values:
#   cp .env.example .env
#
# Then run with --env-file (keeps secrets out of shell history / ps):
#   docker run -d \
#     --name chrome-kb-bridge \
#     -p 9876:9876 \
#     --env-file .env \
#     -v kb-data:/root/.pi/agent/kb \
#     chrome-kb-bridge
#
# NEVER commit .env to version control.
# =============================================================================

# ---------------------------------------------------------------------------
# Required: JWT secret for user authentication
# ---------------------------------------------------------------------------
# Generate a random secret:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# In development, a random per-process secret is used if you omit this,
# but sessions won't survive restarts.

JWT_SECRET=change-me-to-a-random-64-char-string

# ---------------------------------------------------------------------------
# Required: at least one LLM provider API key
# ---------------------------------------------------------------------------
# Pick the provider you use and uncomment its key.  Only one is needed,
# but you can set multiple to switch providers via PI_DEFAULT_PROVIDER.

# Anthropic
ANTHROPIC_API_KEY=sk-ant-...

# OpenAI
#OPENAI_API_KEY=sk-...

# Google Gemini
#GEMINI_API_KEY=...

# DeepSeek
#DEEPSEEK_API_KEY=...

# Groq
#GROQ_API_KEY=...

# Mistral
#MISTRAL_API_KEY=...

# xAI (Grok)
#XAI_API_KEY=...

# OpenRouter
#OPENROUTER_API_KEY=...

# Hugging Face
#HF_TOKEN=...

# Cerebras
#CEREBRAS_API_KEY=...

# Fireworks
#FIREWORKS_API_KEY=...

# Together
#TOGETHER_API_KEY=...

# Vercel AI Gateway
#AI_GATEWAY_API_KEY=...

# Other supported providers (see pi docs/providers.md):
#   Azure OpenAI    → AZURE_OPENAI_API_KEY
#   Z.AI            → ZAI_API_KEY
#   Opencode        → OPENCODE_API_KEY
#   Kimi Coding     → KIMI_API_KEY
#   MiniMax         → MINIMAX_API_KEY
#   Xiaomi          → XIAOMI_API_KEY
#   Together        → TOGETHER_API_KEY

# ---------------------------------------------------------------------------
# Recommended: default provider & model
# ---------------------------------------------------------------------------
# These tell pi which provider and model to use for KB operations.
# If omitted, pi will ask interactively (which breaks in a headless container).

PI_DEFAULT_PROVIDER=anthropic
PI_DEFAULT_MODEL=claude-sonnet-4-20250514

# ---------------------------------------------------------------------------
# Optional: thinking level
# ---------------------------------------------------------------------------
# "off" | "low" | "medium" | "high" | "xhigh"
#PI_DEFAULT_THINKING=off

# ---------------------------------------------------------------------------
# Optional: network settings
# ---------------------------------------------------------------------------
# PORT  — WebSocket listen port (default: 9876)
# HOST  — Listen address (default: 0.0.0.0; set to 127.0.0.1 for host-net mode)
#PORT=9876
#HOST=0.0.0.0

{
  "name": "keb",
  "version": "0.0.1",
  "private": true,
  "packageManager": "pnpm@11.3.0",
  "scripts": {
    "build": "pnpm --filter @keb/extension --filter @keb/landing --filter @keb/web-app build",
    "build:local": "VITE_HOSTED_BRIDGE_URL=ws://127.0.0.1:19876 pnpm --filter @keb/extension build",
    "build:pi-keb": "pnpm --filter @keb/bridge build:pi-keb",
    "build:web-app": "pnpm --filter @keb/web-app build",
    "typecheck": "pnpm --filter './packages/*' --filter '!./packages/pi-keb' typecheck",
    "preview": "pnpm --filter @keb/extension preview",
    "bridge": "pnpm --filter @keb/bridge build:pi-keb && pnpm --filter @keb/bridge start",
    "bridge:dev": "pnpm --filter @keb/bridge build:pi-keb && pnpm --filter @keb/bridge dev",
    "chat:dev": "pnpm --filter @keb/web-app dev",
    "chat:build": "pnpm --filter @keb/web-app build",
    "lint": "oxlint",
    "format": "oxfmt --write --ignore-path=.oxfmtignore packages",
    "format:check": "oxfmt --check --ignore-path=.oxfmtignore packages"
  },
  "devDependencies": {
    "oxfmt": "^0.51.0",
    "oxlint": "^1.66.0",
    "oxlint-tailwindcss": "^1.1.0"
  }
}

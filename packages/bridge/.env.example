# =============================================================================
# chrome-kb bridge — environment variables
#
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# The bridge auto-loads .env when present. No extra flags needed.
# For Docker, pass it with --env-file:
#   docker run -d \
#     --name chrome-kb-bridge \
#     -p 9876:9876 \
#     --env-file .env \
#     -v kb-data:/root/.pi/agent/kb \
#     chrome-kb-bridge
#
# NEVER commit .env to version control.
# =============================================================================

# ---------------------------------------------------------------------------
# Bridge mode: "hosted" (auth required) or "local" (no auth)
# ---------------------------------------------------------------------------
#   hosted — Users must sign up and log in. Requires JWT_SECRET below.
#            This is the default when running via Docker.
#   local  — No login/signup. Extension connects directly.

KEB_MODE=hosted

# ---------------------------------------------------------------------------
# Required for hosted mode: JWT secret for user authentication
# ---------------------------------------------------------------------------
# Generate a random secret:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# In hosted mode, you MUST set this for sessions to survive restarts.
# IMPORTANT: Keep this stable across restarts or all tokens are invalidated.

JWT_SECRET=change-me-to-a-random-64-char-string

# ---------------------------------------------------------------------------
# LLM Provider — custom provider via models.json (recommended)
# ---------------------------------------------------------------------------
# Defines a custom provider + model in ~/.pi/agent/models.json.
# Works with any OpenAI-compatible API, Ollama, vLLM, LM Studio,
# Anthropic-compatible proxies, Google AI Studio, etc.
#
# Required:
#   LLM_PROVIDER   — Provider name/slug (e.g., "ollama", "my-provider")
#   LLM_BASE_URL   — API base URL
#   LLM_MODEL      — Model ID (e.g., "llama3.1:8b", "gpt-4")
#
# Optional:
#   LLM_API        — API type (default: "openai-completions")
#                    See pi docs/models.md for supported APIs:
#                    "anthropic-messages", "google-generative-ai",
#                    "openai-responses"
#   LLM_API_KEY    — API key (required by pi, can be dummy for local models)
#   LLM_MODEL_NAME — Optional human-readable model name
#   LLM_REASONING  — Set "true" for reasoning-capable models

# Example: Ollama (local)
# LLM_PROVIDER=ollama
# LLM_BASE_URL=http://host.docker.internal:11434/v1
# LLM_MODEL=llama3.1:8b
# LLM_API_KEY=ollama

# Example: Anthropic (native API — simplest)
# LLM_PROVIDER=anthropic
# LLM_BASE_URL=https://api.anthropic.com/v1
# LLM_API=anthropic-messages
# LLM_MODEL=claude-sonnet-4-20250514
# LLM_API_KEY=sk-ant-...

# Example: Poolside (Anthropic-compatible API)
# LLM_PROVIDER=poolside
# LLM_BASE_URL=https://api.poolside.ai/v1
# LLM_API=anthropic-messages
# LLM_MODEL=poolside-alpha
# LLM_API_KEY=ps-...

# Example: OpenAI-compatible proxy
# LLM_PROVIDER=my-proxy
# LLM_BASE_URL=https://proxy.example.com/v1
# LLM_MODEL=gpt-4
# LLM_API_KEY=sk-proxy-key...

# ---------------------------------------------------------------------------
# Legacy: native pi API keys (alternative to LLM_* vars above)
# ---------------------------------------------------------------------------
# Only needed if you prefer pi's built-in provider resolution via auth.json.
# Not required when using the LLM_* custom provider approach above.

# Anthropic
# ANTHROPIC_API_KEY=sk-ant-...

# OpenAI
#OPENAI_API_KEY=sk-...

# Google Gemini
#GEMINI_API_KEY=...

# DeepSeek
#DEEPSEEK_API_KEY=...

# Groq
#GROQ_API_KEY=...

# Mistral
#MISTRAL_API_KEY=...

# xAI (Grok)
#XAI_API_KEY=...

# OpenRouter
#OPENROUTER_API_KEY=...

# Hugging Face
#HF_TOKEN=...

# Cerebras
#CEREBRAS_API_KEY=...

# Fireworks
#FIREWORKS_API_KEY=...

# Together
#TOGETHER_API_KEY=...

# Vercel AI Gateway
#AI_GATEWAY_API_KEY=...

# Other supported providers (see pi docs/providers.md):
#   Azure OpenAI    → AZURE_OPENAI_API_KEY
#   Z.AI            → ZAI_API_KEY
#   Opencode        → OPENCODE_API_KEY
#   Kimi Coding     → KIMI_API_KEY
#   MiniMax         → MINIMAX_API_KEY
#   Xiaomi          → XIAOMI_API_KEY
#   Together        → TOGETHER_API_KEY

# ---------------------------------------------------------------------------
# Legacy: default provider & model (alternative to LLM_*)
# ---------------------------------------------------------------------------
# Only needed with the auth.json-based native provider approach above.
# When using LLM_PROVIDER/LLM_MODEL, those are used automatically.

# PI_DEFAULT_PROVIDER=anthropic
# PI_DEFAULT_MODEL=claude-sonnet-4-20250514

# ---------------------------------------------------------------------------
# Optional: thinking level (applies to both LLM_* and PI_DEFAULT_*)
# ---------------------------------------------------------------------------
# "off" | "low" | "medium" | "high" | "xhigh"
#LLM_THINKING=off
#PI_DEFAULT_THINKING=off

# ---------------------------------------------------------------------------
# Optional: admin monitoring
# ---------------------------------------------------------------------------
# ADMIN_KEY — secret key for GET /api/status endpoint (sent via X-API-Key header).
# If unset, the endpoint returns 501 (not configured).
# Generate: node -e "console.log(require('crypto').randomBytes(16).toString('hex'))"
#ADMIN_KEY=

# ---------------------------------------------------------------------------
# Optional: network settings
# ---------------------------------------------------------------------------
# PORT  — WebSocket listen port (default: 9876)
# HOST  — Listen address (default: 0.0.0.0; set to 127.0.0.1 for host-net mode)
#PORT=9876
#HOST=0.0.0.0

{
  "name": "keb",
  "version": "0.0.1",
  "private": true,
  "packageManager": "pnpm@11.3.0",
  "scripts": {
    "build": "pnpm --filter @keb/extension --filter @keb/landing build",
    "build:local": "VITE_HOSTED_BRIDGE_URL=ws://127.0.0.1:19876 pnpm --filter @keb/extension build",
    "build:pi-kb": "pnpm --filter @keb/bridge build:pi-kb",
    "typecheck": "pnpm --filter './packages/*' --filter '!./packages/pi-kb' typecheck",
    "preview": "pnpm --filter @keb/extension preview",
    "bridge": "pnpm --filter @keb/bridge build:pi-kb && pnpm --filter @keb/bridge start",
    "bridge:dev": "pnpm --filter @keb/bridge build:pi-kb && pnpm --filter @keb/bridge dev",
    "lint": "oxlint",
    "format": "oxfmt --write packages",
    "format:check": "oxfmt --check packages"
  },
  "devDependencies": {
    "oxfmt": "^0.51.0",
    "oxlint": "^1.66.0",
    "oxlint-tailwindcss": "^1.1.0"
  }
}

# =============================================================================
# Caddyfile for chrome-kb bridge
#
# Proxies api.mdevd.co/keb/v1 → bridge container on port 9876.
# Caddy handles TLS (Let's Encrypt) automatically and strips the
# /keb/v1 path prefix so the bridge receives clean /api/* paths.
#
# Usage:
#   # With Docker Compose (recommended)
#   docker compose up -d
#
#   # Or run Caddy standalone
#   caddy run --config Caddyfile
#
# Prerequisites:
#   - DNS A/AAAA record pointing api.mdevd.co to your server's public IP
#   - Ports 80 and 443 open on the server (Caddy needs them for HTTP-01 challenge)
# =============================================================================

# Global options (optional — Caddy auto-detects email from ACME if omitted)
# {
#     email your-email@example.com
# }

api.mdevd.co {
    # Strip /keb/v1 prefix before proxying to the bridge.
    # handle_path is essential here — it ensures the bridge receives:
    #   POST /api/signup   (not /keb/v1/api/signup)
    #   GET  /api/me       (not /keb/v1/api/me)
    #   WS   /              (not /keb/v1)
    handle_path /keb/v1/* {
        reverse_proxy bridge:9876 {
            # Caddy handles WebSocket upgrades automatically —
            # no special config needed.
        }

        # OPTIONAL: increase timeouts for long-running operations
        # (compilation can take 30-90s for large pages)
        # reverse_proxy bridge:9876 {
        #     transport http {
        #         read_timeout 120s
        #     }
        # }
    }

    # Health check endpoint (optional — directly available, no prefix needed)
    # respond /health 200

    # Log access (optional)
    # log {
    #     output file /var/log/caddy/keb-access.log
    # }
}
